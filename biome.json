{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": { "ignoreUnknown": false, "includes": ["**"] },
    "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 4, "lineWidth": 120 },
    "linter": {
        "enabled": true,
        "rules": { "preset": "recommended", "correctness": { "noUnusedVariables": "error" } }
    },
    "javascript": {
        "formatter": { "quoteStyle": "single", "trailingCommas": "es5", "semicolons": "always" }
    },
    "json": { "parser": { "allowComments": true } },
    "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
